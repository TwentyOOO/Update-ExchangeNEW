<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" 
    android:padding="16dp" 
    android:layout_width="match_parent" 
    android:layout_height="match_parent"
    android:background="@color/background_light"
    xmlns:android="http://schemas.android.com/apk/res/android" 
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <!-- Enhanced Quick Calculator Card -->
    <androidx.cardview.widget.CardView 
        style="@style/EnhancedCard"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/background_card">
        <LinearLayout 
            android:orientation="vertical" 
            android:padding="20dp" 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content">
            <TextView 
                style="@style/EnhancedText.Title"
                android:textSize="26sp" 
                android:textColor="@color/button_primary" 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:text="الحاسبة السريعة" 
                android:textAlignment="center"
                android:layout_marginBottom="12dp" />
            <TextView 
                style="@style/EnhancedText.Subtitle"
                android:textSize="18sp" 
                android:textColor="@color/text_secondary_dark" 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:text="قريباً..." 
                android:textAlignment="center" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    
    <!-- Enhanced Instructions Card -->
    <androidx.cardview.widget.CardView 
        style="@style/EnhancedCard"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/background_card">
        <LinearLayout 
            android:orientation="vertical" 
            android:padding="20dp" 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content">
            <TextView 
                style="@style/EnhancedText.Title"
                android:textSize="22sp" 
                android:textColor="@color/text_primary_dark"
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:text="طريقة الاستخدام" 
                android:textAlignment="center"
                android:layout_marginBottom="16dp" />
            <TextView 
                style="@style/EnhancedText.Body"
                android:textSize="16sp"
                android:textColor="@color/text_primary_dark" 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginBottom="12dp"
                android:lineSpacingExtra="4dp"
                android:text="1. فعّل الحاسبة من الزر أعلاه\n2. افتح أي تطبيق (مثل واتساب)\n3. اكتب الأمر بأحد الطرق التالية:" />
            <TextView 
                style="@style/EnhancedText.Caption"
                android:textSize="15sp" 
                android:textColor="@color/text_secondary_dark" 
                android:background="@color/background_light" 
                android:padding="16dp" 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:elevation="2dp"
                android:lineSpacingExtra="3dp"
                android:text="الطريقة 1:\nاشحن 1000 درهم على AE123456 عبر الوكيل الهيبة\n\nالطريقة 2:\n1 1000 4 51+=" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    
    <!-- Enhanced Status Text -->
    <TextView 
        style="@style/EnhancedText.Subtitle"
        android:textSize="18sp" 
        android:textColor="@color/warning_color" 
        android:id="@id/statusText" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:layout_margin="20dp" 
        android:text="الحاسبة غير مفعلة" 
        android:textAlignment="center"
        android:background="@color/background_card"
        android:padding="16dp"
        android:elevation="2dp" />
</LinearLayout>