<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- الخلفية الأساسية -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1a1d2e"/>
        </shape>
    </item>
    
    <!-- دوائر كبيرة في الزوايا -->
    <item
        android:top="-150dp"
        android:left="-150dp">
        <shape android:shape="oval">
            <solid android:color="#0AFFFFFF"/>
            <size android:width="300dp" android:height="300dp"/>
        </shape>
    </item>
    
    <item
        android:top="-200dp"
        android:right="-200dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF"/>
            <size android:width="400dp" android:height="400dp"/>
        </shape>
    </item>
    
    <item
        android:bottom="-180dp"
        android:left="50dp">
        <shape android:shape="oval">
            <solid android:color="#0A3498DB"/>
            <size android:width="350dp" android:height="350dp"/>
        </shape>
    </item>
    
    <item
        android:bottom="-100dp"
        android:right="-100dp">
        <shape android:shape="oval">
            <solid android:color="#0A27AE60"/>
            <size android:width="250dp" android:height="250dp"/>
        </shape>
    </item>
    
    <!-- نقاط صغيرة منتشرة -->
    <item
        android:top="100dp"
        android:right="80dp">
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF"/>
            <size android:width="50dp" android:height="50dp"/>
        </shape>
    </item>
    
    <item
        android:top="250dp"
        android:left="120dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF"/>
            <size android:width="30dp" android:height="30dp"/>
        </shape>
    </item>
    
</layer-list>

