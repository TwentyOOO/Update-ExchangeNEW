<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- الخلفية الأساسية بتدرج -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="800dp"
                android:centerX="0.5"
                android:centerY="0.3"
                android:startColor="#1c2833"
                android:centerColor="#17202a"
                android:endColor="#13181f"/>
        </shape>
    </item>
    
    <!-- دائرة كبيرة زرقاء شفافة في الأعلى -->
    <item
        android:top="-150dp"
        android:left="-100dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:startColor="#1F3498DB"
                android:centerColor="#143498DB"
                android:endColor="#00000000"/>
            <size android:width="400dp" android:height="400dp"/>
        </shape>
    </item>
    
    <!-- دائرة متوسطة في الأسفل اليمين -->
    <item
        android:bottom="-120dp"
        android:right="-80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:startColor="#1A2196F3"
                android:centerColor="#0F2196F3"
                android:endColor="#00000000"/>
            <size android:width="320dp" android:height="320dp"/>
        </shape>
    </item>
    
    <!-- طبقة زرقاء شفافة على الكل -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A3498DB"/>
        </shape>
    </item>
    
</layer-list>

