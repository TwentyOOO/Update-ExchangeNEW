<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- الخلفية -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1a1d2e"/>
        </shape>
    </item>
    
    <!-- نقاط كبيرة -->
    <item android:top="50dp" android:left="30dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
    
    <item android:top="180dp" android:right="60dp">
        <shape android:shape="oval">
            <solid android:color="#0A3498DB"/>
            <size android:width="120dp" android:height="120dp"/>
        </shape>
    </item>
    
    <item android:top="350dp" android:left="100dp">
        <shape android:shape="oval">
            <solid android:color="#0F27AE60"/>
            <size android:width="60dp" android:height="60dp"/>
        </shape>
    </item>
    
    <item android:bottom="200dp" android:right="40dp">
        <shape android:shape="oval">
            <solid android:color="#14F39C12"/>
            <size android:width="90dp" android:height="90dp"/>
        </shape>
    </item>
    
    <item android:bottom="80dp" android:left="70dp">
        <shape android:shape="oval">
            <solid android:color="#0A9C27B0"/>
            <size android:width="70dp" android:height="70dp"/>
