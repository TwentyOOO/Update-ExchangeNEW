<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/item_price_background">

    <!-- رقم التسلسل -->
    <TextView
        android:id="@+id/tv_sequence_number"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="1"
        android:textSize="14sp"
        android:textColor="@color/btn_records"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/number_circle_bg"/>

    <!-- اسم التسعيرة -->
    <TextView
        android:id="@+id/tv_price_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="تسعيرة 265"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:gravity="start|center_vertical"/>

    <!-- أيقونة السهم -->
    <TextView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:text="▶"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"/>

</LinearLayout>
